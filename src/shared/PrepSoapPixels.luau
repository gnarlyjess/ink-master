local PrepSoapPixels = {}
PrepSoapPixels.width = W
PrepSoapPixels.height = H
function PrepSoapPixels.pixels(): buffer
	local raw = buffer.create(W * H * 4)
	local hi = 0
	for i = 1, #HEX, 2 do
		local byte = tonumber(string.sub(HEX, i, i + 1), 16)
		if byte ~= nil then
			buffer.writeu8(raw, hi, byte)
			hi += 1
		end
	end
	return raw
end
return PrepSoapPixels
