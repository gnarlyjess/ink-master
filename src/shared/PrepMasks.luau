--!strict
-- Auto-generated: skin cells for prep hair/dirt under ScaleType.Crop.
-- Regenerate with scripts/bake_prep_masks.py

local COLS = 32
local ROWS = 40

local MASKS: { [string]: string } = {
	LeftForearm = "",
	LeftUpperArm = "",
	LeftThigh = "",
	LeftCalf = "",
	Chest = "",
	Back = "",
}

local PrepMasks = {}
PrepMasks.COLS = COLS
PrepMasks.ROWS = ROWS

local decoded: { [string]: { number } } = {}

function PrepMasks.get(regionId: string): { number }?
	local cached = decoded[regionId]
	if cached ~= nil then
		return cached
	end
	local bits = MASKS[regionId]
	if bits == nil then
		return nil
	end
	local cells = table.create(COLS * ROWS, 0)
	for i = 1, #bits do
		cells[i] = if string.sub(bits, i, i) == "1" then 1 else 0
	end
	decoded[regionId] = cells
	return cells
end

function PrepMasks.isSkin(regionId: string, col: number, row: number): boolean
	local cells = PrepMasks.get(regionId)
	if cells == nil then
		return true
	end
	local index = (row - 1) * COLS + col
	return cells[index] == 1
end

function PrepMasks.isSkinUv(regionId: string, x: number, y: number): boolean
	local col = math.clamp(math.floor(x * COLS) + 1, 1, COLS)
	local row = math.clamp(math.floor(y * ROWS) + 1, 1, ROWS)
	return PrepMasks.isSkin(regionId, col, row)
end

return PrepMasks
